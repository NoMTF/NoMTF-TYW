{
  "name": "nomtf-tyw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "npm run compile && node --import tsx --test test/*.test.mjs test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run compile && node scripts/build-exit.mjs && node scripts/build-site.mjs && npm run typecheck && wrangler deploy --dry-run --outdir build/worker",
    "dev": "vite --host 127.0.0.1",
    "worker:dev": "wrangler dev",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-ethers": "1.8.24",
    "@reown/appkit-wallet-button": "1.8.24",
    "@uniswap/v4-core": "1.0.2",
    "ethers": "6.17.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@types/node": "^24.0.0",
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "4.149.0"
  },
  "optionalDependencies": {
    "@foundry-rs/anvil-win32-amd64": "1.7.1"
  }
}
